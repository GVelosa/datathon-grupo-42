# ── Anthropic API ─────────────────────────────────────────────────────────────
# Obrigatório para: agente ReAct, LLM judge, avaliação A/B
ANTHROPIC_API_KEY=sk-ant-...

# ── MLflow Tracking ───────────────────────────────────────────────────────────
# Local: deixar vazio (salva em ./mlruns)
# Remoto: http://mlflow-server:5000
MLFLOW_TRACKING_URI=

# ── Serving ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Langfuse (opcional — observabilidade LLM) ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
