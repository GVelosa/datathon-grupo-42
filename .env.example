# ── Provider LLM ──────────────────────────────────────────────────────────────
# Define o backend de inferência do agente ReAct.
# 'anthropic' = API cloud (padrão, sem GPU)
# 'vllm'      = LLM local com quantização (requer GPU NVIDIA + vLLM rodando)
LLM_PROVIDER=anthropic

# ── Anthropic API (usado quando LLM_PROVIDER=anthropic) ───────────────────────
# Obrigatório para: agente ReAct, LLM judge, avaliação A/B, RAGAS (langchain-anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Anthropic a usar (padrão: Haiku — menor custo/latência)
AGENT_MODEL=claude-haiku-4-5-20251001

# ── vLLM — LLM Local com Quantização (usado quando LLM_PROVIDER=vllm) ─────────
# URL da API OpenAI-compatible exposta pelo servidor vLLM
# Docker: http://vllm:8080/v1  |  Local: http://localhost:8080/v1
VLLM_BASE_URL=http://localhost:8080/v1

# Modelo HuggingFace a servir no vLLM
# Llama 3.1 8B (recomendado — multilíngue, suporte PT-BR)
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# Alternativa com melhor PT-BR nativo:
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Tipo de quantização: awq (4-bit, ~6GB VRAM) | int8 (8-bit, ~10GB VRAM) | fp16 (sem quantização)
VLLM_QUANTIZATION=awq

# Porta do servidor vLLM (padrão 8080 para não conflitar com fraud-api em 8000)
VLLM_PORT=8080

# Contexto máximo em tokens (4096 é suficiente para o agente ReAct)
VLLM_MAX_MODEL_LEN=4096

# Fração da VRAM reservada para o modelo (0.90 = 90%)
VLLM_GPU_MEM_UTIL=0.90

# Token HuggingFace — obrigatório para Llama (modelo gated)
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ── MLflow Tracking ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Serving ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Langfuse (opcional — observabilidade LLM) ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
