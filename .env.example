# ── Anthropic API ─────────────────────────────────────────────────────────────
# Obrigatório para: agente ReAct, LLM judge, avaliação A/B
ANTHROPIC_API_KEY=sk-ant-...

# ── MLflow Tracking ───────────────────────────────────────────────────────────
# Aponta para o MLflow do Docker (sobe com docker compose up -d)
# Assim o treino local loga direto no servidor — aparece em http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Serving ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Langfuse (opcional — observabilidade LLM) ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
